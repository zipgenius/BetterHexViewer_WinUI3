<Window
    x:Class="BetterHexViewer.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hex="using:BetterHexViewer.WinUI3"
    Title="BetterHexViewer WinUI 3">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ Hex viewer + status bar ═══════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <hex:BetterHexViewer
                x:Name="HexViewer"
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                SelectionChanged="HexViewer_SelectionChanged"/>

            <!-- Status bar -->
            <Grid Grid.Row="1"
                  Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
                  Padding="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock TextWrapping="Wrap" x:Name="TxtFileName"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock TextWrapping="Wrap" x:Name="TxtFileSize"
                           Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock TextWrapping="Wrap" x:Name="TxtSelection"
                           Grid.Column="2"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock TextWrapping="Wrap" x:Name="TxtBytesPerLine"
                           Grid.Column="3"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock TextWrapping="Wrap" x:Name="TxtHover"
                           Grid.Column="4"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </Grid>
        </Grid>

        <!-- ═══════ Right-side toolbar ═══════ -->
        <Border Grid.Column="1"
                Width="310"
                Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,12">
                <StackPanel Spacing="0">

                    <!-- ── File ── -->
                    <TextBlock x:Name="LabelFileSection" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,12,12,4"/>
                    <Button x:Name="BtnOpenFile"
                            HorizontalAlignment="Stretch"
                            Margin="8,0"
                            Click="BtnOpenFile_Click"/>

                    <Button x:Name="BtnShowSelection"
                            HorizontalAlignment="Stretch"
                            Margin="8,4,8,0"
                            Click="BtnShowSelection_Click"/>

                    <!-- ── Search ── -->
                    <TextBlock x:Name="LabelSearchSection" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,16,12,4"/>

                    <!-- Mode toggle -->
                    <Grid Margin="8,0,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbSearchText"
                                     Grid.Column="0"
                                     IsChecked="True"
                                     GroupName="SearchMode"
                                     Checked="RbSearchMode_Changed"/>
                        <RadioButton x:Name="RbSearchHex"
                                     Grid.Column="1"
                                     GroupName="SearchMode"
                                     Checked="RbSearchMode_Changed"/>
                    </Grid>

                    <TextBox x:Name="TxtSearch"
                             HorizontalAlignment="Stretch"
                             Margin="8,0"
                             KeyDown="TxtSearch_KeyDown"/>

                    <!-- Hint label (shown when Hex mode is active) -->
                    <TextBlock TextWrapping="Wrap" x:Name="TxtSearchHint"
                               FontSize="10"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,2,12,0"/>
                    <!-- Shown only in Text mode -->
                    <CheckBox x:Name="ChkIgnoreCase"
                              FontSize="11"
                              Margin="8,2,8,0"
                              IsChecked="False"/>
                    <!-- Search result message -->
                    <TextBlock TextWrapping="Wrap" x:Name="TxtSearchResult"
                               FontSize="11"
                               Margin="12,4,12,0"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                    <Grid Margin="8,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSearchPrev"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,2,0"
                                Click="BtnSearchPrev_Click"/>
                        <Button x:Name="BtnSearchNext"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,0,0"
                                Click="BtnSearchNext_Click"/>
                    </Grid>

                    <Button x:Name="BtnFindAll"
                            HorizontalAlignment="Stretch"
                            Margin="8,4,8,0"
                            Click="BtnFindAll_Click"/>

                    <!-- ── Font ── -->
                    <TextBlock x:Name="LabelFontSection" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,16,12,4"/>

                    <!-- Font family combobox (monospaced fonts) -->
                    <TextBlock x:Name="LabelFontFamily" TextWrapping="Wrap"  Margin="12,0,12,2" FontSize="11"/>
                    <ComboBox x:Name="CmbFont"
                              HorizontalAlignment="Stretch"
                              Margin="8,0"
                              SelectionChanged="CmbFont_SelectionChanged"/>

                    <!-- Font size -->
                    <Grid Margin="8,6,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelFontSize" TextWrapping="Wrap"  Grid.Column="0" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="BtnFontMinus" Content="−" Width="32" Height="28"
                                    Click="BtnFontMinus_Click" />
                            <TextBlock TextWrapping="Wrap" x:Name="TxtFontSize" Text="13" Width="26"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <Button x:Name="BtnFontPlus"  Content="+" Width="32" Height="28"
                                    Click="BtnFontPlus_Click"  />
                        </StackPanel>
                    </Grid>

                    <!-- Bold toggle -->
                    <ToggleButton x:Name="TglBold"
                                  HorizontalAlignment="Stretch"
                                  Margin="8,6,8,0"
                                  IsChecked="False"
                                  Checked="TglBold_Changed"
                                  Unchecked="TglBold_Changed"/>

                    <!-- ── Layout ── -->
                    <TextBlock x:Name="LabelLayoutSection" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,16,12,4"/>

                    <!-- Offset format -->
                    <TextBlock x:Name="LabelOffsetFormat" TextWrapping="Wrap"  Margin="12,0,12,2" FontSize="11"/>
                    <ComboBox x:Name="CmbOffset"
                              HorizontalAlignment="Stretch"
                              Margin="8,0"
                              SelectionChanged="CmbOffset_SelectionChanged"
                              >
                        <ComboBoxItem x:Name="LabelHexadecimal"  IsSelected="True"/>
                        <ComboBoxItem x:Name="LabelDecimal" />
                        <ComboBoxItem x:Name="LabelOctal" />
                    </ComboBox>

                    <!-- Column grouping -->
                    <TextBlock x:Name="LabelColumnGrouping" TextWrapping="Wrap"  Margin="12,6,12,2" FontSize="11"/>
                    <ComboBox x:Name="CmbGroup"
                              HorizontalAlignment="Stretch"
                              Margin="8,0"
                              SelectionChanged="CmbGroup_SelectionChanged"
                              >
                        <ComboBoxItem x:Name="LabelOneByte"    IsSelected="True"/>
                        <ComboBoxItem x:Name="LabelByteCount2" />
                        <ComboBoxItem x:Name="LabelByteCount4" />
                        <ComboBoxItem x:Name="LabelByteCount8" />
                        <ComboBoxItem x:Name="LabelByteCount16" />
                    </ComboBox>

                    <!-- ASCII encoding -->
                    <TextBlock x:Name="LabelAsciiEncoding" TextWrapping="Wrap"  Margin="12,6,12,2" FontSize="11"/>
                    <ComboBox x:Name="CmbEncoding"
                              HorizontalAlignment="Stretch"
                              Margin="8,0"
                              SelectionChanged="CmbEncoding_SelectionChanged"/>

                    <!-- Byte spacing -->
                    <Grid Margin="12,6,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelByteSpacing" TextWrapping="Wrap"  Grid.Column="0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock TextWrapping="Wrap" x:Name="TxtSpacingVal" Text="10" Grid.Column="1"
                                   Width="22" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                    </Grid>
                    <Slider x:Name="SldrSpacing"
                            Margin="8,0"
                            Minimum="2" Maximum="24" Value="10"
                            StepFrequency="1" SnapsTo="StepValues"
                            ValueChanged="SldrSpacing_ValueChanged"/>

                    <!-- Row gap -->
                    <Grid Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelRowGap" TextWrapping="Wrap"  Grid.Column="0" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock TextWrapping="Wrap" x:Name="TxtLineGapVal" Text="4" Grid.Column="1"
                                   Width="22" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                    </Grid>
                    <Slider x:Name="SldrLineGap"
                            Margin="8,0"
                            Minimum="0" Maximum="12" Value="4"
                            StepFrequency="1" SnapsTo="StepValues"
                            ValueChanged="SldrLineGap_ValueChanged"/>

                    <!-- Toggles -->
                    <ToggleButton x:Name="TglFullWidth"
                                  HorizontalAlignment="Stretch"
                                  Margin="8,4,8,0"
                                  IsChecked="False"
                                  Checked="TglFullWidth_Changed"
                                  Unchecked="TglFullWidth_Changed"/>

                    <ToggleButton x:Name="TglAscii"
                                  HorizontalAlignment="Stretch"
                                  Margin="8,4,8,0"
                                  IsChecked="True"
                                  Checked="TglAscii_Changed"
                                  Unchecked="TglAscii_Changed"/>

                    <!-- ── Colours ── -->
                    <TextBlock x:Name="LabelColoursSection" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,16,12,4"/>

                    <!-- Theme preset -->
                    <TextBlock x:Name="LabelThemePreset" TextWrapping="Wrap"  Margin="12,0,12,2" FontSize="11"/>
                    <ComboBox x:Name="CmbTheme"
                              HorizontalAlignment="Stretch"
                              Margin="8,0"
                              SelectionChanged="CmbTheme_SelectionChanged"
                              >
                        <ComboBoxItem x:Name="LabelLight"    IsSelected="True"/>
                        <ComboBoxItem x:Name="LabelDark" />
                        <ComboBoxItem x:Name="LabelMatrix" />
                    </ComboBox>

                    <!-- Individual colour pickers (two-column grid) -->
                    <Grid Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Background -->
                        <TextBlock x:Name="LabelBackground" TextWrapping="Wrap"  Grid.Row="0" Grid.Column="0"
                                   FontSize="10" Margin="2,4,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorBg" Grid.Row="0" Grid.Column="1"
                                Height="26" Margin="2,4,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorBg_Click"
                                >
                            <Border x:Name="SwatchBg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FFFAF9F8"/>
                        </Button>

                        <!-- Foreground -->
                        <TextBlock x:Name="LabelForeground" TextWrapping="Wrap"  Grid.Row="1" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorFg" Grid.Row="1" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorFg_Click"
                                >
                            <Border x:Name="SwatchFg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FF1B1B1B"/>
                        </Button>

                        <!-- Offset fg -->
                        <TextBlock x:Name="LabelOffsetText" TextWrapping="Wrap"  Grid.Row="2" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorOffset" Grid.Row="2" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorOffset_Click"
                                >
                            <Border x:Name="SwatchOffset" Width="60" Height="14" CornerRadius="2"
                                    Background="#FF00008B"/>
                        </Button>

                        <!-- Offset bg -->
                        <TextBlock x:Name="LabelOffsetBackground" TextWrapping="Wrap"  Grid.Row="3" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorOffsetBg" Grid.Row="3" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorOffsetBg_Click"
                                >
                            <Border x:Name="SwatchOffsetBg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FFE8E8E8"/>
                        </Button>

                        <!-- ASCII bg -->
                        <TextBlock x:Name="LabelAsciiBackground" TextWrapping="Wrap"  Grid.Row="4" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorAsciiBg" Grid.Row="4" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorAsciiBg_Click"
                                >
                            <Border x:Name="SwatchAsciiBg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FFE8E8E8"/>
                        </Button>

                        <!-- Divider -->
                        <TextBlock x:Name="LabelDivider" TextWrapping="Wrap"  Grid.Row="5" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorDivider" Grid.Row="5" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorDivider_Click"
                                >
                            <Border x:Name="SwatchDivider" Width="60" Height="14" CornerRadius="2"
                                    Background="#FF808080"/>
                        </Button>

                        <!-- Selection bg -->
                        <TextBlock x:Name="LabelSelectionBackground" TextWrapping="Wrap"  Grid.Row="6" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorSelBg" Grid.Row="6" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorSelBg_Click"
                                >
                            <Border x:Name="SwatchSelBg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FF0078D7"/>
                        </Button>

                        <!-- Selection fg -->
                        <TextBlock x:Name="LabelSelectionText" TextWrapping="Wrap"  Grid.Row="7" Grid.Column="0"
                                   FontSize="10" Margin="2,2,2,1" VerticalAlignment="Center"/>
                        <Button x:Name="BtnColorSelFg" Grid.Row="7" Grid.Column="1"
                                Height="26" Margin="2,2,2,1"
                                HorizontalAlignment="Stretch"
                                Click="BtnColorSelFg_Click"
                                >
                            <Border x:Name="SwatchSelFg" Width="60" Height="14" CornerRadius="2"
                                    Background="#FFFFFFFF" BorderBrush="#20000000" BorderThickness="1"/>
                        </Button>
                    </Grid>

                    <!-- Reset colours -->
                    <Button x:Name="BtnResetColors"
                            HorizontalAlignment="Stretch"
                            Margin="8,8,8,0"
                            Click="BtnResetColors_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
